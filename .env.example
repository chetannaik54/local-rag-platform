# Copy to .env (repo root or backend/). All values shown are the defaults.
# Chat/embedding/chunking values are only *initial* defaults: once you save the
# Settings page, the saved values (stored in data/app.db) take precedence.

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_S=120

# --- Retrieval / generation ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.35
TEMPERATURE=0.2
NUM_CTX=8192
MAX_TOKENS=1024
EMBED_BATCH_SIZE=32
HISTORY_MESSAGES=6

# --- Backend ---
# DATA_DIR=./data            # SQLite, ChromaDB and uploaded files live here
MAX_UPLOAD_MB=50
RESPONSE_LANGUAGE=auto       # auto = reply in the user's language

# --- Auth, connectors, widget, voice ---
AUTH_ENABLED=false           # true = login required; organizations (tenants) and role-based access
# ADMIN_EMAIL=admin@localhost # platform admin login (first start with auth on)
# ADMIN_PASSWORD=            # platform admin password; empty = generated and saved to data/admin_credentials.txt
# ADMIN_TOKEN=               # optional fixed platform-admin API key (else saved to data/admin_token.txt)
SESSION_HOURS=12             # how long a login stays valid
MIN_PASSWORD_LENGTH=10
LOGIN_FAILURES_PER_15MIN=8   # wrong passwords per email before it waits 15 minutes
# PUBLIC_URL=https://rag.example.com  # how browsers reach this server; used in website-embed snippets
# CONNECTOR_ROOTS=C:\path\to\shared\docs   # folders connectors may read (default data/sources)
ALLOW_PRIVATE_URLS=false    # true lets the URL connector fetch localhost/LAN addresses
# WIDGET_ORIGINS=             # extra browser origins allowed to call the API. Embed keys manage their own sites in Admin.
WHISPER_MODEL=base          # speech-to-text model (tiny|base|small|medium)
CONFIRM_ACTIONS=true        # assistant actions (leave, tickets...) wait for the user to press Confirm
RATE_LIMIT_PER_MINUTE=60    # chat/upload/voice requests per user per minute (0 = off)
AUTH_FAILURES_PER_MINUTE=20 # wrong-token attempts per client IP before a 1-minute lockout
MAX_JSON_BODY_KB=256        # request body cap for non-upload endpoints
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Frontend (frontend/.env) ---
# Leave unset in dev: Vite proxies /api to http://127.0.0.1:8000.
# VITE_API_URL=http://127.0.0.1:8000
# VITE_PROXY_TARGET=http://127.0.0.1:8000
